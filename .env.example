# GEMINI_API_KEY: Unused by NEXORA VPN (leave commented out unless needed)
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==============================================================================
# ANDROID BUILD & PUBLIC CONFIG (Safe to expose via Secrets / BuildConfig)
# ==============================================================================
# Production HTTPS URL of your hosted NEXORA VPN Node.js Backend (no localhost).
NEXORA_API_BASE_URL=https://api.yourdomain.com

# Official SpeedOf.Me Public Account Key & Authorized Domain (NEVER put API Secret here)
SPEEDOFME_API_KEY=YOUR_SPEEDOFME_API_KEY
SPEEDOFME_DOMAIN=YOUR_REGISTERED_DOMAIN

# ==============================================================================
# BACKEND SERVER SECRETS (Ignored from APK BuildConfig via app/build.gradle.kts)
# Set these only on your backend server / Railway / Render / Fly.io / VPS .env
# ==============================================================================
DATABASE_URL=postgresql://nexora_user:CHANGE_ME@localhost:5432/nexora_vpn
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARS
ADMIN_SECRET=CHANGE_ME_TO_STRONG_ADMIN_SECRET
GOOGLE_PLAY_SERVICE_ACCOUNT=
WIREGUARD_SERVER_PUBLIC_KEY=
