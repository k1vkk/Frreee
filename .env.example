# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# NEXORA_API_BASE_URL: Production HTTPS URL of your hosted NEXORA VPN Node.js Backend.
# Replace with your deployed domain (e.g. https://api.nexoravpn.com) via AI Studio Secrets.
NEXORA_API_BASE_URL=https://api.yourdomain.com

# SPEEDOFME_API_KEY: Public SpeedOf.Me API Key (Account Key) from https://speedof.me/api.
# Configure in the AI Studio Secrets panel. NEVER put an API Secret here.
SPEEDOFME_API_KEY=YOUR_SPEEDOFME_API_KEY

# SPEEDOFME_DOMAIN: Registered domain authorized in your SpeedOf.Me API dashboard.
SPEEDOFME_DOMAIN=YOUR_REGISTERED_DOMAIN

