# NEXORA VPN Control Plane — Backend Environment Variables Example
# Copy to backend/.env and replace all placeholder values before deploying.
# NEVER commit real secrets or production backend/.env files to version control.

# Runtime & Server
NODE_ENV=production
PORT=4000
TRUST_PROXY=true
ENFORCE_HTTPS=true

# Public Domain & CORS (must be an explicit HTTPS origin in production, never "*")
API_DOMAIN=api.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGIN=https://api.yourdomain.com

# PostgreSQL / Supabase Direct Connection (Backend-Only)
# Never expose these variables with VITE_ or NEXT_PUBLIC_ prefixes.
DATABASE_URL=postgresql://nexora:REPLACE_WITH_STRONG_DB_PASSWORD@your-postgres-host:5432/nexora_vpn
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Provide PEM content (with \n escapes) or file path for Supabase / managed Postgres CA verification
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# Used by backend/docker-compose.yml local Postgres service
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Cryptographic Secrets (generate each with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_SECRET
JWT_EXPIRES_IN=30d
ADMIN_SECRET=REPLACE_WITH_64_CHAR_HEX_ADMIN_SECRET
ADMIN_API_KEY=REPLACE_WITH_64_CHAR_HEX_ADMIN_SECRET
NODE_AGENT_SECRET=REPLACE_WITH_64_CHAR_HEX_NODE_AGENT_SECRET

# WireGuard VPS Node Agent Defaults
NODE_AGENT_PORT=51821
WG_INTERFACE=wg0

# Google Play Billing Verification (Backend-Only)
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.nexoravpn.nxrk7q
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Transactional Email for Password Reset OTP (Optional)
RESEND_API_KEY=
SMTP_WEBHOOK_URL=
MAIL_FROM=NEXORA VPN <security@yourdomain.com>

# SpeedOf.Me Speed Test Credentials (Optional; falls back to Cloudflare HTTP if unset)
SPEEDOFME_API_KEY=
SPEEDOFME_DOMAIN=
