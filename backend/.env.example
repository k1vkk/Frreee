# ==============================================================================
# NEXORA VPN Control Plane - Production Environment Configuration (HTTPS)
# Copy this file to .env and replace all placeholders before deploying.
# Never use localhost in production or commit real secrets to git.
# ==============================================================================

NODE_ENV=production
PORT=4000
TRUST_PROXY=true
ENFORCE_HTTPS=true

# Public HTTPS domain & URL for your Control Plane (used by Caddy TLS & health checks)
API_DOMAIN=api.yourdomain.com
NEXORA_API_BASE_URL=https://api.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGIN=https://api.yourdomain.com

# External Managed PostgreSQL / Supabase (SERVER-ONLY — never expose in Android or frontend)
# For Supabase Pooler, use Session Mode (port 5432) with ?sslmode=require.
# Supply DATABASE_CA_CERT (PEM string or file path) to enable strict TLS verification.
DATABASE_URL=postgres://postgres.REPLACE_PROJECT_REF:REPLACE_WITH_STRONG_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional Supabase Admin API credentials (STRICTLY SERVER-SIDE ONLY — never VITE_* or BuildConfig)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cryptographic Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_SECRET
JWT_EXPIRES_IN=30d
ADMIN_SECRET=REPLACE_WITH_64_CHAR_HEX_ADMIN_SECRET
ADMIN_API_KEY=REPLACE_WITH_64_CHAR_HEX_ADMIN_SECRET
NODE_AGENT_SECRET=REPLACE_WITH_64_CHAR_HEX_AGENT_SECRET

# Optional default WireGuard public key reference for single-node setups
WIREGUARD_SERVER_PUBLIC_KEY=

# Optional SpeedOf.Me Public API Configuration (never put an API secret here)
SPEEDOFME_API_KEY=
SPEEDOFME_DOMAIN=

# Password Reset Email Delivery (Resend API key or custom HTTPS webhook)
RESEND_API_KEY=
MAIL_FROM=NEXORA VPN <security@yourdomain.com>
SMTP_WEBHOOK_URL=

# Google Play Developer API validation (Service Account JSON string or file path)
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.nexoravpn.nxrk7q
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional: set to wg0 only if Control Plane runs on the same Linux WireGuard host
WG_INTERFACE=
