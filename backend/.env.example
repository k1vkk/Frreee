# ==============================================================================
# NEXORA VPN Control Plane - Production Environment Configuration (HTTPS)
# Copy this file to .env and fill in your real production values before deploy.
# Never use localhost in production.
# ==============================================================================

NODE_ENV=production
PORT=4000
TRUST_PROXY=true
ENFORCE_HTTPS=true

# Public HTTPS domain & URL for your Control Plane (used by Caddy TLS & health checks)
API_DOMAIN=api.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGIN=https://api.yourdomain.com

# External Managed PostgreSQL (Neon, Supabase, RDS, Render, DigitalOcean)
# Or set host to 'postgres' when running inside the bundled Docker Compose stack
DATABASE_URL=postgres://nexora:REPLACE_WITH_STRONG_PASSWORD@db.yourdomain.com:5432/nexora_vpn?sslmode=require
DATABASE_SSL=true
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Cryptographic Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_SECRET
JWT_EXPIRES_IN=30d
ADMIN_API_KEY=REPLACE_WITH_64_CHAR_HEX_ADMIN_KEY
NODE_AGENT_SECRET=REPLACE_WITH_64_CHAR_HEX_AGENT_SECRET

# Password Reset Email Delivery (configure Resend API key or custom HTTPS webhook)
RESEND_API_KEY=
MAIL_FROM=NEXORA VPN <security@yourdomain.com>
SMTP_WEBHOOK_URL=

# Google Play Developer API validation (Service Account JSON string or file path)
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.nexoravpn.nxrk7q
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional: set to wg0 only if the Control Plane shares a Linux WireGuard host
WG_INTERFACE=
